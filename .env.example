# Copy to .env.local and fill in. Never commit real values.
# Local values come from `npm run db:status` after `npm run db:start`.

# Supabase — public (safe for the browser; row-level security protects the data)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:44321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server only (bypasses row-level security)
SUPABASE_SECRET_KEY=

# Signs guest booking links and the slot-hold cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Public URL of the app, used in e-mail links (defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=

# Optional integrations. Leave empty to use the built-in local mode.
# Stripe (test mode only). Without keys, payments use the built-in simulator with Stripe's test card numbers.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Resend. Without a key, e-mails are rendered into the outbox and shown in the admin console.
RESEND_API_KEY=
EMAIL_FROM=
# Anthropic. Without a key, the AI assistant is switched off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Shared secret for the scheduled-job endpoints.
CRON_SECRET=
