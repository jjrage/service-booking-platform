# Copy to .env.local and fill in. Never commit real values.
# Local values come from `npm run db:status` after `npm run db:start`.

# Supabase — public (safe for the browser; row-level security protects the data)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:44321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — server only (bypasses row-level security)
SUPABASE_SECRET_KEY=
