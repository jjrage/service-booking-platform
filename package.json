{
  "name": "service-booking-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "test:db": "supabase test db && vitest run --config vitest.integration.mts",
    "db:types": "supabase gen types typescript --local > src/db/database.types.ts && prettier --write src/db/database.types.ts",
    "db:seed": "tsx scripts/seed.ts",
    "jobs:local": "tsx scripts/jobs-local.ts",
    "eval:ai": "vitest run --config vitest.ai-eval.mts",
    "test:e2e": "playwright test",
    "test:stripe": "vitest run --config vitest.stripe.mts",
    "stripe:listen": "tsx scripts/stripe-listen.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@stripe/react-stripe-js": "6.10.0",
    "@stripe/stripe-js": "9.16.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "22.6.2",
    "temporal-polyfill": "1.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "supabase": "^2.120.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
